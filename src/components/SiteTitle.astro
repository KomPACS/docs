---
import logo from '../assets/logo.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="kp-title" translate="no">
  <img src={logo.src} alt="" width="28" height="28" />
  <span class="kp-wordmark"><span class="kp-kom">KOM</span>PACS</span>
  <span class="kp-docs">docs</span>
</a>

<style>
  .kp-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .kp-wordmark {
    color: var(--sl-color-white);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .kp-kom {
    color: var(--kp-kom);
  }
  .kp-docs {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }
</style>
