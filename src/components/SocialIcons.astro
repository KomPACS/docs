---
import Default from '@astrojs/starlight/components/SocialIcons.astro'

const cs = Astro.locals.starlightRoute.locale !== 'en'
---

<Default />
<a class="kp-pill" href="https://demo.kompacs.cz">Demo</a>
<a class="kp-pill kp-pill-solid" href={cs ? 'https://kompacs.cz' : 'https://kompacs.cz/en/'}>kompacs.cz</a>

<style>
  .kp-pill {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .kp-pill:hover {
    border-color: var(--sl-color-accent);
  }
  .kp-pill.kp-pill-solid {
    border-color: var(--sl-color-accent);
    background-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .kp-pill.kp-pill-solid:hover {
    background-color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent-high);
  }
</style>
