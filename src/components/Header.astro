---
import Default from '@astrojs/starlight/components/Header.astro'

const { topics } = Astro.locals.starlightSidebarTopics
const { locale } = Astro.locals.starlightRoute
const label = locale === 'en' ? 'Documentation sections' : 'Sekce dokumentace'
---

<div class="kp-header">
  <div class="kp-header-top"><Default /></div>
  <nav class="kp-tabs" aria-label={label}>
    {
      topics.map((topic) => (
        <a href={topic.link} class:list={{ current: topic.isCurrent }} aria-current={topic.isCurrent ? 'page' : undefined}>
          {topic.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  .kp-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .kp-header-top {
    height: var(--kp-header-top);
    flex-shrink: 0;
  }
  .kp-tabs {
    display: none;
  }
  @media (min-width: 50rem) {
    .kp-tabs {
      display: flex;
      gap: 1.75rem;
      align-items: stretch;
      flex: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .kp-tabs a {
      display: flex;
      align-items: center;
      border-bottom: 2px solid transparent;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }
    .kp-tabs a:hover {
      color: var(--sl-color-white);
    }
    .kp-tabs a.current {
      border-bottom-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }
  }
</style>
